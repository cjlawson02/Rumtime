{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Group non-major npm updates in the kiosk UI",
      "matchFileNames": ["ui/kiosk/**"],
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "kiosk non-major"
    },
    {
      "description": "Keep GitHub Actions updates grouped",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    }
  ]
}
