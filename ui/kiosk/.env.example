# LAN device base URL (MSW intercepts in dev when hostname is not an IPv4)
VITE_DEVICE_API_BASE=http://rumtime.local

# Force mock device on/off in Vite (`true`/`false`). Unset: auto (off for IPv4 bases).
# VITE_USE_MSW=true

# 4-digit setup PIN — required for production builds (see lib/config.ts).
VITE_SETUP_PIN=

# Status poll interval (ms)
VITE_DEVICE_POLL_MS=500
